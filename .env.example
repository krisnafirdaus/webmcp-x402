# SpendMCP — environment variables (all optional; defaults run Instant Demo Mode)

# --- Server (apps/workspace) ---

# '1' (default) = Instant Demo Mode: signatures verified, settlement simulated.
# '0' = Real x402 Mode: settle via the facilitator on Base Sepolia.
MOCK_MODE=1

# Recipient address for payments (defaults to a placeholder in demo mode).
# REQUIRED in real mode — use an address you control.
# PAY_TO=0xYourAddress

# x402 facilitator endpoint (real mode only).
# FACILITATOR_URL=https://x402.org/facilitator

# --- Client (must be set at build time) ---

# Mirror of MOCK_MODE for the UI badge/receipts. '0' = real mode.
NEXT_PUBLIC_MOCK_MODE=1

# '1' exposes window.__spendmcpTools for Playwright/e2e (never set in production).
# NEXT_PUBLIC_TEST=1

# There are NO private keys in any environment variable. The demo wallet key is
# generated in the visitor's browser and never leaves it.
